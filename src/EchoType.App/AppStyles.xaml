<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EchoType.App">
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="#EEF3F4"/>
            <Setter Property="BorderBrush" Value="#CEDADB"/><Setter Property="Foreground" Value="#203A40"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="BorderBrush" Value="#CEDADB"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6,0,10"/></Style>
        <Style TargetType="TabItem"><Setter Property="Padding" Value="18,10"/></Style>
        <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="34"/></Style>
</ResourceDictionary>
