<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- ビルド時のヘッダー取得のみ。SDKのネイティブDLLはコピーしない。 -->
    <PackageDownload Include="Microsoft.CognitiveServices.Speech" Version="[1.49.0]" />
    <Content Include="$(BaseIntermediateOutputPath)caption-native\$(Configuration)\BackendProbe.exe" Link="CaptionDll\CaptionDllHost.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\EchoType.Core\EchoType.Core.csproj" />
    <Content Include="Asr\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Exclude="Asr\**\__pycache__\**" />
    <Content Include="..\..\dev\scripts\setup-asr.ps1" Link="setup-asr.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\dev\scripts\setup-haas.ps1" Link="setup-haas.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.11" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="BuildCaptionDllHost" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildProjectDirectory)\..\CaptionNative\src\BackendProbe.cpp;$(MSBuildProjectDirectory)\..\CaptionNative\scripts\build-probe.ps1"
          Outputs="$(BaseIntermediateOutputPath)caption-native\$(Configuration)\BackendProbe.exe">
    <PropertyGroup>
      <CaptionNativeOutput>$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)caption-native\$(Configuration)', '$(MSBuildProjectDirectory)'))</CaptionNativeOutput>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\CaptionNative\scripts\build-probe.ps1&quot; -Source BackendProbe -SdkIncludePath &quot;$(NuGetPackageRoot)/microsoft.cognitiveservices.speech\1.49.0\build\native\include&quot; -OutputDirectory &quot;$(CaptionNativeOutput)&quot;" />
  </Target>
</Project>
