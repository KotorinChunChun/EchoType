<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <NoWarn>$(NoWarn);8305</NoWarn>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.4.8-experimental" /></ItemGroup>
  <ItemGroup><None Include="$(NuGetPackageRoot)microsoft.windowsappsdk.ai/2.4.8-experimental/license.txt" Link="WindowsAI-license.txt" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.3.5-experimental" /></ItemGroup>
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)microsoft.windowsappsdk.ml/2.3.5-experimental/license.txt" Link="WindowsML-SDK-license.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.windows.ai.machinelearning/2.6.74-rc/license.txt" Link="WindowsML-Runtime-license.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.windows.ai.machinelearning/2.6.74-rc/ThirdPartyNotices.txt" Link="WindowsML-ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
